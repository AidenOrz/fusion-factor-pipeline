{
  "source": "starter_plus_deepseek_v4_flash",
  "expressions": [
    {
      "id": "mom_20",
      "expression": "rank(close / ts_shift(close, 20))",
      "direction": "long",
      "hypothesis": "20-day price momentum persists",
      "engine": "builtin"
    },
    {
      "id": "rev_5",
      "expression": "rank(-ts_delta(close, 5) / ts_shift(close, 5))",
      "direction": "long",
      "hypothesis": "5-day short-term reversal",
      "engine": "builtin"
    },
    {
      "id": "vol_20",
      "expression": "rank(-ts_std(close / ts_shift(close, 1) - 1, 20))",
      "direction": "long",
      "hypothesis": "low volatility outperforms",
      "engine": "builtin"
    },
    {
      "id": "trend_10",
