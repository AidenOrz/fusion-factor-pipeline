# Python and local tooling
__pycache__/
*.py[cod]
.pytest_cache/
.tmp/
.tmp_pytest/
.venv/
.env
.env.*
!.env.example

# Local/generated artifacts
artifacts/
data/
runs/*

# Keep the small, reviewable selection outputs that are referenced by the
# factor-processing report.  Large matrices and market-data files stay local.
!runs/
!runs/factor_selection_v2_direction_review/
!runs/factor_selection_v2_direction_review/*.csv
!runs/factor_selection_v2_direction_review/*.json
!runs/factor_selection_v2_direction_review/*.md

# Forward observation record (2026-10-18). These are small, reviewable evidence
# for the registered protocol: the first reading, the equivalence gate, and the
# industry-divergence return profile. The parquet payloads stay local.
!runs/forward_shadow_2026-10-17/
!runs/forward_shadow_2026-10-17/*.csv
!runs/forward_shadow_2026-10-17/*.json
!runs/forward_shadow_2026-10-18_pit/
!runs/forward_shadow_2026-10-18_pit/*.csv
!runs/forward_shadow_2026-10-18_pit/*.json
!runs/forward_evaluation_2026-10-18/
!runs/forward_evaluation_2026-10-18/*.csv
!runs/forward_evaluation_2026-10-18/*.json
!runs/forward_labels_2026-10-18/
!runs/forward_labels_2026-10-18/*.json
!runs/scorer_equivalence_2026-10-18/
!runs/scorer_equivalence_2026-10-18/*.json
!runs/industry_divergence_returns_2026-10-18/
!runs/industry_divergence_returns_2026-10-18/*.json

# Derived market data and serialized panels
*.parquet
*.sqlite3
*.db

# Robustness round (2026-10-19): small reviewable evidence only.
!runs/robustness_pack_2026-10-19/
!runs/robustness_pack_2026-10-19/*.json
!runs/horizon_sensitivity_2026-10-19/
!runs/horizon_sensitivity_2026-10-19/*.json
!runs/accel_benchmark_2026-10-19/
!runs/accel_benchmark_2026-10-19/*.json

# Rust build output is never committed; only source and Cargo.lock.
rust/*/target/
